# CMA Scheduling webapp — environment template.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# (`.env.local` is git-ignored; this example file holds placeholders only.)

# ID of the production "Inspections" Google Sheet (the long ID from its URL).
SHEET_ID=your-spreadsheet-id

# Tab the dashboard reads. Defaults to "Inspections" if unset.
SHEET_TAB=Inspections

# Absolute path to a Google service-account key JSON. This file MUST live
# OUTSIDE this repository (never commit it). The Google Sheet must be shared
# with the service-account's "client_email" (e.g.
# pintame-prime@<project>.iam.gserviceaccount.com) with at least Viewer access,
# or reads will fail with a permission error.
# GOOGLE_APPLICATION_CREDENTIALS is used as a fallback if this is unset.
GOOGLE_SA_KEY_PATH=/absolute/path/outside/repo/service-account.json

# --- Phase 2 sync trigger (optional; "Sync now" button) ---------------------

# n8n webhook URL of the "LC360 Scheduling Sync (Phase 2)" workflow (POST).
# Leave blank until the webhook exists; /api/sync returns 503 while unset.
N8N_WEBHOOK_URL=

# Shared secret sent to n8n in the `x-sync-secret` header. Must match the
# value the n8n workflow checks. Keep blank if the webhook is unauthenticated.
N8N_SYNC_SECRET=
