# Template for infra/.env.staging — Staging Postgres for the CMA Scheduling
# webapp (Phase 1). Copy to infra/.env.staging and fill in real values;
# infra/.env.staging is git-ignored and must never be committed.
#
# Generate a strong password, e.g.:  openssl rand -hex 24
POSTGRES_USER=cma_staging
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cma_staging

# Host port the staging DB is published on, bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5433

# Connection string consumed by the sheet->db migrate script and by the staging
# webapp systemd unit (cma-scheduling-webapp-staging). Keep host = 127.0.0.1.
DATABASE_URL=postgresql://cma_staging:CHANGE_ME@127.0.0.1:5433/cma_staging

# LC360 portal credentials for the direct ingest (scripts/ingest-lc360-to-db.ts).
# Real values live ONLY in the git-ignored infra/.env.staging. Use placeholders here.
LC360_PREFERRED_USERNAME=CHANGE_ME
LC360_SUTTON_USERNAME=CHANGE_ME
LC360_PASSWORD=CHANGE_ME

# n8n webhook for POST /api/sync when DATA_SOURCE=db (cma-scheduling-webapp-staging):
# the DB-driven "LC360 Sync (DB)" workflow. Same n8n host as the sheet-mode
# webhook; only the path segment differs (lc360-sync -> lc360-sync-db). The
# secret stays N8N_SYNC_SECRET (webapp/.env.local) - both workflows check the
# same $env.SYNC_SECRET.
N8N_WEBHOOK_URL_DB=http://192.168.1.74:5678/webhook/lc360-sync-db
